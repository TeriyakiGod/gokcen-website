---
interface Props { tag: string; title: string; intro?: string; center?: boolean }
const { tag, title, intro, center = true } = Astro.props;
---
<div class:list={['mb-10', center && 'text-center']}>
  <span class="grammar-tag">📖 {tag}</span>
  <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{title}</h2>
  {intro && <p class:list={['mt-3 text-lg text-muted', center && 'mx-auto max-w-2xl']}>{intro}</p>}
</div>
