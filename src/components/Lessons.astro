---
import { t, type Lang } from '../i18n';
import { business } from '../config/business';
import SectionTitle from './SectionTitle.astro';
import LevelQuiz from './LevelQuiz.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).lessons;
const levels = ['A2', 'B1', 'B2', 'C1', 'C2'];
---
<section id="lessons" class="bg-paper py-20">
  <div class="mx-auto max-w-6xl px-4">
    <SectionTitle tag={d.tag} title={d.title} intro={d.intro} />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {d.types.map((x) => (
        <article class="card p-6 transition hover:-translate-y-1 hover:rotate-[-0.5deg]">
          <div class="text-4xl" aria-hidden="true">{x.icon}</div>
          <h3 class="mt-3 text-xl font-semibold">{x.title}</h3>
          <p class="mt-2 text-muted">{x.text}</p>
        </article>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
      <span class="mr-2 font-bold">{d.levels}:</span>
      {levels.map((l, i) => (
        <span class="rounded-full px-3 py-1 font-display font-semibold" style={`background: color-mix(in oklab, var(--c-coral) ${15 + i * 15}%, var(--c-paper))`}>{l}</span>
      ))}
    </div>
    <div class="mt-14 grid gap-8 lg:grid-cols-2">
      <div class="card notebook p-8 pl-16">
        <h3 class="text-2xl font-semibold">{d.howTitle}</h3>
        <ol class="mt-4 space-y-4 text-lg">
          {d.how.map((s, i) => (
            <li class="flex gap-3"><span class="grid size-8 shrink-0 place-items-center rounded-full bg-coral font-display font-semibold text-white">{i + 1}</span><span class="leading-8">{s}</span></li>
          ))}
        </ol>
      </div>
      <div class="card p-8">
        <h3 class="text-2xl font-semibold">{d.pricesTitle}</h3>
        <ul class="mt-4 divide-y divide-line">
          {business.lessons.prices.map((p) => (
            <li class="flex items-baseline justify-between gap-4 py-3">
              <span class="font-bold">{d.prices[p.key]} <span class="text-sm font-normal text-muted">· {'count' in p ? `${p.count} × ` : ''}{p.minutes} {d.perLesson}</span></span>
              <span class="font-display text-xl font-semibold text-coral">{p.amount === 0 ? d.free : `${p.amount} ${business.currency}`}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mt-8">
      <LevelQuiz lang={lang} />
    </div>
  </div>
</section>
