---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).fun;
---
<canvas id="dog-canvas" aria-hidden="true"></canvas>
<div id="dog-bubble" class="bubble pointer-events-none fixed top-0 left-0 z-50 w-64 text-sm" hidden></div>
<div id="dog-controls" class="fixed bottom-4 left-4 z-50 flex items-center gap-2" data-labels={JSON.stringify(d)}>
  <button type="button" class="dc-ball grid size-12 place-items-center rounded-full border-2 border-ink/10 bg-ball text-2xl shadow-lg transition hover:scale-110 aria-pressed:ring-4 aria-pressed:ring-coral" title={d.throwBall} aria-label={d.throwBall} aria-pressed="false">🎾</button>
  <p class="dc-hint bubble hidden text-sm font-bold">{d.throwHint}</p>
  <details class="relative">
    <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-full border border-line bg-paper shadow" aria-label="Settings">⚙️</summary>
    <div class="card absolute bottom-12 left-0 w-48 space-y-2 p-3 text-sm font-bold">
      <label class="flex items-center gap-2"><input type="checkbox" class="dc-paws size-4 accent-coral" /> 🐾 {d.pawTrail}</label>
      <label class="flex items-center gap-2"><input type="checkbox" class="dc-dogs size-4 accent-coral" checked /> 🐕 {d.dogsOn}</label>
    </div>
  </details>
</div>
<script>
  const controls = document.getElementById('dog-controls')!;
  const canvas = document.getElementById('dog-canvas') as HTMLCanvasElement;
  const bubble = document.getElementById('dog-bubble')!;
  const ballBtn = controls.querySelector<HTMLButtonElement>('.dc-ball')!;
  const hint = controls.querySelector<HTMLElement>('.dc-hint')!;
  const pawsBox = controls.querySelector<HTMLInputElement>('.dc-paws')!;
  const dogsBox = controls.querySelector<HTMLInputElement>('.dc-dogs')!;

  const get = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = matchMedia('(pointer: fine)').matches;
  let stop: (() => void) | null = null;

  async function startDogs() {
    if (stop) return;
    const { startDogScene } = await import('../three/DogScene');
    try {
      stop = startDogScene({ canvas, bubble, count: innerWidth < 640 ? 1 : 3 });
      canvas.hidden = false;
      ballBtn.hidden = false;
    } catch (e) {
      console.warn('Dogs could not start (no WebGL?)', e);
    }
  }
  function stopDogs() {
    stop?.();
    stop = null;
    canvas.hidden = true;
    ballBtn.hidden = true;
  }

  dogsBox.checked = !reduced && get('dogs') !== 'off';
  if (dogsBox.checked) {
    const idle = (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 300));
    addEventListener('load', () => idle(startDogs), { once: true });
  } else stopDogs();
  dogsBox.addEventListener('change', () => {
    set('dogs', dogsBox.checked ? 'on' : 'off');
    dogsBox.checked ? startDogs() : stopDogs();
  });

  ballBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    dispatchEvent(new CustomEvent('dogs:throw'));
  });
  addEventListener('dogs:throwmode', (e) => {
    const on = (e as CustomEvent).detail as boolean;
    ballBtn.setAttribute('aria-pressed', String(on));
    hint.classList.toggle('hidden', !on);
  });

  // Paw-print cursor trail (desktop only)
  if (!finePointer || reduced) pawsBox.closest('label')!.hidden = true;
  pawsBox.checked = finePointer && !reduced && get('paws') === 'on';
  pawsBox.addEventListener('change', () => set('paws', pawsBox.checked ? 'on' : 'off'));
  const pawSvg = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><g fill="#ff7a5c"><ellipse cx="32" cy="42" rx="14" ry="12"/><circle cx="16" cy="26" r="6"/><circle cx="26" cy="17" r="6"/><circle cx="38" cy="17" r="6"/><circle cx="48" cy="26" r="6"/></g></svg>')}`;
  let lastPaw = { x: 0, y: 0 }, flip = false;
  addEventListener('pointermove', (e) => {
    if (!pawsBox.checked) return;
    const dx = e.clientX - lastPaw.x, dy = e.clientY - lastPaw.y;
    if (dx * dx + dy * dy < 1600) return;
    lastPaw = { x: e.clientX, y: e.clientY };
    flip = !flip;
    const angle = (Math.atan2(dy, dx) * 180) / Math.PI + 90;
    const img = document.createElement('img');
    img.src = pawSvg;
    img.alt = '';
    img.className = 'paw-print';
    const off = flip ? 8 : -8;
    img.style.left = `${e.clientX - 9 + off}px`;
    img.style.top = `${e.clientY - 9}px`;
    img.style.rotate = `${angle}deg`;
    document.body.append(img);
    setTimeout(() => img.remove(), 1200);
  }, { passive: true });
</script>
